VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Google Books API key (Books API enabled, no billing required) — used for
# ISBN and title/author book lookups. Ships in the client bundle like the
# Supabase publishable key above, so restrict it by HTTP referrer in Google
# Cloud Console to this app's domain(s) rather than leaving it unrestricted.
VITE_GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here
